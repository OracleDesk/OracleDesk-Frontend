{
  "name": "oracledesk-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/build-sw-manifest.mjs",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:scripts": "node --test \"scripts/__tests__/*.test.mjs\"",
    "test:props": "FC_RUNS=20000 vitest run lib/stellar/__tests__/fpmm-properties.test.ts",
    "test:mutation": "stryker run && node scripts/check-mutation-score.mjs",
    "test:coverage": "vitest run --coverage",
    "sync:bindings": "node scripts/sync-bindings.mjs",
    "check:bindings": "node scripts/sync-bindings.mjs --check",
    "spec:diff": "node scripts/spec-diff.mjs",
    "fixtures:record": "node scripts/record-fixtures.mjs",
    "fixtures:check": "node scripts/record-fixtures.mjs --check",
    "test:api-contract": "vitest run --config vitest.contract.config.mts",
    "check:api-doc": "node scripts/check-api-doc.mjs",
    "check:api-errors": "node scripts/extract-api-error-codes.mjs --check",
    "check:env": "node scripts/check-env-example.mjs",
    "check:sdk": "node scripts/check-sdk-major.mjs",
    "check:x402": "node scripts/check-x402-versions.mjs",
    "check:ci-claims": "node scripts/check-ci-claims.mjs",
    "check:origins": "node scripts/check-external-origins.mjs",
    "check:docs": "node scripts/check-doc-claims.mjs",
    "i18n:check": "node scripts/i18n-check.mjs",
    "i18n:types": "node scripts/i18n-check.mjs --write",
    "i18n:pseudo": "node scripts/i18n-check.mjs --pseudo",
    "check:route-params": "node scripts/check-route-params.mjs",
    "check:route-links": "node scripts/check-route-links.mjs",
    "scan:secrets": "node scripts/scan-build-secrets.mjs",
    "install:allowed-scripts": "node scripts/run-allowed-install-scripts.mjs",
    "perf:lhci": "node scripts/run-lhci.mjs",
    "e2e:x402": "vitest run --config vitest.x402.config.mts",
    "e2e:testnet": "vitest run --config vitest.e2e.config.mts"
  },
  "allowedInstallScripts": [
    {
      "name": "sharp",
      "reason": "Next.js image optimization loads sharp's native binding at runtime."
    }
  ],
  "dependencies": {
    "@creit.tech/stellar-wallets-kit": "2.5.0",
    "@stellar/stellar-sdk": "^16.3.1",
    "@tanstack/react-query": "^5.100.10",
    "@tanstack/react-virtual": "3.14.21",
    "@x402/core": "^2.26.0",
    "@x402/stellar": "^2.26.0",
    "axios": "^1.16.1",
    "buffer": "^6.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.38.0",
    "intl-messageformat": "11.2.7",
    "lucide-react": "^1.16.0",
    "next": "16.2.6",
    "radix-ui": "^1.4.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-is": "^19.2.6",
    "recharts": "^3.8.1",
    "shadcn": "^4.7.0",
    "socket.io-client": "^4.8.3",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "~4.6.7"
  },
  "devDependencies": {
    "@formatjs/icu-messageformat-parser": "3.5.23",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/typescript-checker": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "5.0.3",
    "autoprefixer": "^10.5.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "fake-indexeddb": "6.2.8",
    "fast-check": "3.23.2",
    "jsdom": "29.1.1",
    "postcss": "^8.5.14",
    "socket.io": "4.8.3",
    "tailwindcss": "^3.4.19",
    "typescript": "^5",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "license": "MIT"
}
